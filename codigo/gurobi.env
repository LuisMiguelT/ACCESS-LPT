# gurobi.env — parámetros para los solves MIP/LP que lanza BaPCod
# TimeLimit: tope por llamada (heurística de master restringido, MIP de enumeración)
TimeLimit 1800
# MIPGap 0: CRÍTICO para exactitud. Antes estaba en 0.05 (5%): con costos
# ~72000 eso permite parar un MIP hasta ~3600 unidades lejos del óptimo,
# lo que invalida tanto la heurística como el MIP final de enumeración.
MIPGap 0.05
OutputFlag 1
